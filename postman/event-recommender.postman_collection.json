    {
      "name": "Recommendations",
      "description": "Personalised event recommendations based on categories and/or location",
      "item": [
        {
          "name": "Get Recommendations — By Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Result count does not exceed limit', function () {",
                  "    pm.expect(pm.response.json().length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categories\": [\"TECHNOLOGY\", \"MUSIC\"],\n  \"limit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "recommendations"]
            },
            "description": "Returns a ranked list of recommended events filtered by preferred categories.\n\n**Request body fields:**\n- `categories` (optional, default: []) — set of preferred Category enum values\n- `limit` (optional, default: 10) — maximum number of results\n- `latitude`, `longitude`, `city`, `country` — ALL four are required together to filter by location\n- `maxDistanceKm` (optional) — radius filter in kilometres (requires full location)\n\n**Returns:** 200 OK with a JSON array of EventResponse objects (may be empty).\n\n**Note:** When `categories` is empty, cold-start recommendations are returned (no category filter applied)."
          },
          "response": [
            {
              "name": "200 OK — Recommendations returned",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
