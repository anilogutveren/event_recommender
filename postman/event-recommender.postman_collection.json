    {
      "name": "Events",
      "description": "CRUD operations on events",
      "item": [
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has id', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    // Store for subsequent requests",
                  "    pm.collectionVariables.set('eventId', json.id);",
                  "});",
                  "",
                  "pm.test('Response has all required fields', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.all.keys('id', 'title', 'description', 'category',",
                  "        'latitude', 'longitude', 'city', 'country', 'venue',",
                  "        'startTime', 'endTime', 'tags', 'createdAt');",
                  "});",
                  "",
                  "pm.test('Category is TECHNOLOGY', function () {",
                  "    pm.expect(pm.response.json().category).to.eql('TECHNOLOGY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Kotlin Conference Berlin\",\n  \"description\": \"Annual Kotlin developer conference covering language updates, coroutines, and multiplatform.\",\n  \"category\": \"TECHNOLOGY\",\n  \"latitude\": 52.52,\n  \"longitude\": 13.405,\n  \"city\": \"Berlin\",\n  \"country\": \"Germany\",\n  \"venue\": \"Berlin Expo Center\",\n  \"startTime\": \"2026-09-15T09:00:00Z\",\n  \"endTime\": \"2026-09-16T18:00:00Z\",\n  \"tags\": [\"kotlin\", \"jvm\", \"open-source\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "Creates a new event.\n\n**Required fields:** title, description, category, latitude, longitude, city, country, venue, startTime, endTime\n**Optional fields:** tags (defaults to empty set)\n\n**Returns:** 201 Created with the full EventResponse body.\n\n**Validation:**\n- title and description must not be blank\n- venue must not be blank\n- endTime must be after startTime\n- category must be one of: MUSIC, SPORTS, ARTS, TECHNOLOGY, FOOD, BUSINESS, EDUCATION, HEALTH, OTHER\n\nThe returned `id` is automatically saved to the `eventId` collection variable."
          },
