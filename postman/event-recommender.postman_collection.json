              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"title\": \"Kotlin Conference Berlin\",\n    \"description\": \"Annual Kotlin developer conference.\",\n    \"category\": \"TECHNOLOGY\",\n    \"latitude\": 52.52,\n    \"longitude\": 13.405,\n    \"city\": \"Berlin\",\n    \"country\": \"Germany\",\n    \"venue\": \"Berlin Expo Center\",\n    \"startTime\": \"2026-09-15T09:00:00Z\",\n    \"endTime\": \"2026-09-16T18:00:00Z\",\n    \"tags\": [\"kotlin\", \"jvm\"],\n    \"createdAt\": \"2026-06-10T20:00:00Z\"\n  }\n]"
            }
